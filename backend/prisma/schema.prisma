generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALESPERSON
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  REFERRAL
  COLD_EMAIL
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(SALESPERSON)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads              Lead[]              @relation("AssignedLeads")
  notes              Note[]
  statusChangeHistory LeadStatusHistory[]
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  company      String
  email        String
  phone        String
  source       LeadSource @default(WEBSITE)
  status       LeadStatus @default(NEW)
  dealValue    Decimal    @db.Decimal(12, 2)
  assignedToId String
  assignedTo   User       @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  notes              Note[]
  statusChangeHistory LeadStatusHistory[]

  @@index([status])
  @@index([assignedToId])
  @@index([source])
}

model Note {
  id          String   @id @default(uuid())
  content     String   @db.Text
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model LeadStatusHistory {
  id          String     @id @default(uuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedById String
  changedBy   User       @relation(fields: [changedById], references: [id])
  fromStatus  LeadStatus
  toStatus    LeadStatus
  changedAt   DateTime   @default(now())
}
